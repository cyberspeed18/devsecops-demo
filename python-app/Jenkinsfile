// =====================================================================
// Jenkinsfile : python-app  (Python + Flask)
// Job type    : Pipeline script from SCM   (Script Path = python-app/Jenkinsfile)
// Requires    : Docker on the Jenkins host, user "jenkins" in group "docker"
//               (run scripts/setup-jenkins-host.sh). No extra Jenkins plugins
//               are needed except for optional SonarQube / registry push.
//
// Stages
//   Checkout -> Secret scan -> Install & unit test -> SCA (pip-audit)
//   -> SAST (Bandit + Semgrep) -> [SAST SonarQube] -> Dockerfile lint -> Docker build
//   -> Image scan (Trivy) -> SBOM (Syft) -> Run container + smoke test
//   -> [DAST ZAP baseline] -> [Push image]
//
// STRICT_MODE = false : findings turn the stage/build UNSTABLE (yellow)
// STRICT_MODE = true  : findings FAIL the build (red)
// =====================================================================

def softFail(Closure body) {
    if (params.STRICT_MODE) {
        body()
    } else {
        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
            body()
        }
    }
}

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    parameters {
        booleanParam(name: 'STRICT_MODE', defaultValue: false, description: 'เปิด = เจอช่องโหว่แล้ว build FAIL / ปิด = แค่ UNSTABLE (สีเหลือง)')
        booleanParam(name: 'RUN_SONAR',   defaultValue: false, description: 'SonarQube (ต้องมี plugin + server ชื่อ sonarqube)')
        booleanParam(name: 'RUN_ZAP',     defaultValue: true,  description: 'DAST ด้วย OWASP ZAP baseline (ฟรี ใช้แทน Acunetix ตอน demo)')
        booleanParam(name: 'PUSH_IMAGE',  defaultValue: false, description: 'Push image ไป registry (ต้องมี credentials registry-cred)')
        string(name: 'REGISTRY', defaultValue: 'ghcr.io/your-org', description: 'ใช้เมื่อเปิด PUSH_IMAGE')
    }

    environment {
        APP_DIR    = 'python-app'
        APP_PORT   = '5000'
        PY_IMAGE   = 'python:3.12-slim'
        IMAGE      = "demo/python-app:${env.BUILD_NUMBER}"
        NET        = "demo-net-py-${env.BUILD_NUMBER}"
        CONTAINER  = "demo-py-${env.BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm
                sh '''
                    mkdir -p reports && chmod 777 reports
                    ls -la
                    git log -1 --oneline || true
                '''
            }
        }

        stage('Secret Scan - Gitleaks') {
            steps {
                softFail {
                    sh '''
                        docker run --rm \
                            -u "$(id -u):$(id -g)" -e HOME=/tmp \
                            -v "$WORKSPACE":/repo \
                            zricethezav/gitleaks:latest detect \
                            --source /repo --redact --exit-code 1 \
                            --report-format sarif --report-path /repo/reports/gitleaks.sarif
                    '''
                }
            }
        }

        stage('Install & Unit Test') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        docker run --rm \
                            -u "$(id -u):$(id -g)" -e HOME=/tmp \
                            -v "$PWD":/app -w /app \
                            ${PY_IMAGE} sh -c "
                                python --version &&
                                python -m venv .venv &&
                                .venv/bin/pip install --quiet --disable-pip-version-check -r requirements.txt -r requirements-dev.txt &&
                                .venv/bin/python -m pytest -q
                            "
                    '''
                }
            }
        }

        stage('SCA - pip-audit') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        docker run --rm \
                            -u "$(id -u):$(id -g)" -e HOME=/tmp \
                            -v "$PWD":/app -v "$WORKSPACE/reports":/reports -w /app \
                            ${PY_IMAGE} sh -c ".venv/bin/pip-audit -r requirements.txt --progress-spinner off -f json -o /reports/pip-audit.json || true"
                    '''
                    softFail {
                        sh '''
                            docker run --rm \
                                -u "$(id -u):$(id -g)" -e HOME=/tmp \
                                -v "$PWD":/app -w /app \
                                ${PY_IMAGE} .venv/bin/pip-audit -r requirements.txt --progress-spinner off
                        '''
                    }
                }
            }
        }

        stage('SAST - Bandit') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        docker run --rm \
                            -u "$(id -u):$(id -g)" -e HOME=/tmp \
                            -v "$PWD":/app -v "$WORKSPACE/reports":/reports -w /app \
                            ${PY_IMAGE} sh -c ".venv/bin/bandit -r app -ll -f json -o /reports/bandit.json || true"
                    '''
                    softFail {
                        sh '''
                            docker run --rm \
                                -u "$(id -u):$(id -g)" -e HOME=/tmp \
                                -v "$PWD":/app -w /app \
                                ${PY_IMAGE} .venv/bin/bandit -r app -ll
                        '''
                    }
                }
            }
        }

        stage('SAST - Semgrep') {
            steps {
                dir(env.APP_DIR) {
                    softFail {
                        sh '''
                            docker run --rm \
                                -u "$(id -u):$(id -g)" -e HOME=/tmp \
                                -v "$PWD":/src -v "$WORKSPACE/reports":/reports \
                                semgrep/semgrep:latest semgrep scan \
                                --config p/python --config p/flask --config p/owasp-top-ten \
                                --metrics=off --exclude .venv \
                                --sarif-output=/reports/semgrep-python.sarif --error
                        '''
                    }
                }
            }
        }

        stage('SAST - SonarQube') {
            when { expression { params.RUN_SONAR } }
            steps {
                dir(env.APP_DIR) {
                    withSonarQubeEnv('sonarqube') {
                        sh '''
                            docker run --rm \
                                -u "$(id -u):$(id -g)" -e HOME=/tmp \
                                -e SONAR_HOST_URL="$SONAR_HOST_URL" -e SONAR_TOKEN="$SONAR_AUTH_TOKEN" \
                                -v "$PWD":/usr/src \
                                sonarsource/sonar-scanner-cli:latest \
                                -Dsonar.projectKey=demo-python-app \
                                -Dsonar.sources=app -Dsonar.tests=tests \
                                -Dsonar.python.version=3.12 \
                                -Dsonar.exclusions=.venv/**
                        '''
                    }
                }
                // ต้องตั้ง webhook ใน SonarQube ชี้มาที่ <jenkins>/sonarqube-webhook/
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: params.STRICT_MODE
                }
            }
        }

        stage('Dockerfile Lint - Hadolint') {
            steps {
                dir(env.APP_DIR) {
                    softFail {
                        sh 'docker run --rm -i hadolint/hadolint hadolint --failure-threshold warning - < Dockerfile'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir(env.APP_DIR) {
                    sh 'docker build -t ${IMAGE} .'
                }
            }
        }

        stage('Image Scan - Trivy') {
            steps {
                sh '''
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v trivy-cache:/root/.cache \
                        -v "$WORKSPACE/reports":/reports \
                        aquasec/trivy:latest image \
                        --format json --output /reports/trivy-python.json ${IMAGE} || true
                '''
                softFail {
                    sh '''
                        docker run --rm \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            -v trivy-cache:/root/.cache \
                            aquasec/trivy:latest image \
                            --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 ${IMAGE}
                    '''
                }
            }
        }

        stage('SBOM - Syft') {
            steps {
                sh '''
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v "$WORKSPACE/reports":/reports \
                        anchore/syft:latest ${IMAGE} \
                        -o cyclonedx-json=/reports/sbom-python.cdx.json
                '''
            }
        }

        stage('Run Container & Smoke Test') {
            steps {
                sh '''
                    docker network create ${NET}
                    docker run -d --name ${CONTAINER} --network ${NET} --network-alias app ${IMAGE}
                    for i in $(seq 1 20); do
                        if docker run --rm --network ${NET} curlimages/curl:latest -fsS http://app:${APP_PORT}/health; then
                            echo "smoke test OK"
                            exit 0
                        fi
                        sleep 2
                    done
                    echo "smoke test FAILED"
                    docker logs ${CONTAINER}
                    exit 1
                '''
            }
        }

        stage('DAST - OWASP ZAP baseline') {
            when { expression { params.RUN_ZAP } }
            steps {
                softFail {
                    sh '''
                        docker run --rm --network ${NET} \
                            -v "$WORKSPACE/reports":/zap/wrk:rw \
                            ghcr.io/zaproxy/zaproxy:stable zap-baseline.py \
                            -t http://app:${APP_PORT} -r zap-python.html -I
                    '''
                }
            }
        }

        stage('Push Image') {
            when { expression { params.PUSH_IMAGE } }
            steps {
                withCredentials([usernamePassword(credentialsId: 'registry-cred',
                                                  usernameVariable: 'REG_USER',
                                                  passwordVariable: 'REG_PASS')]) {
                    sh '''
                        echo "$REG_PASS" | docker login ${REGISTRY%%/*} -u "$REG_USER" --password-stdin
                        docker tag ${IMAGE} ${REGISTRY}/demo-python-app:${BUILD_NUMBER}
                        docker push ${REGISTRY}/demo-python-app:${BUILD_NUMBER}
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                docker rm -f ${CONTAINER} >/dev/null 2>&1 || true
                docker network rm ${NET} >/dev/null 2>&1 || true
            '''
            archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
        }
        success  { echo 'Pipeline succeeded' }
        unstable { echo 'Pipeline UNSTABLE - มี finding จาก scan ดูรายงานใน Build Artifacts (reports/)' }
        failure  { echo 'Pipeline FAILED - เปิด Console Output ดู stage ที่ล้ม' }
    }
}
